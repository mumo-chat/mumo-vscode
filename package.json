{
  "name": "mumo-vscode",
  "displayName": "mumo",
  "description": "Multi-model deliberation panel. Diverse AI voices + claim-level reactions on contested decisions.",
  "version": "0.2.0",
  "publisher": "mumo",
  "license": "MIT",
  "author": {
    "name": "mumo",
    "url": "https://mumo.chat"
  },
  "homepage": "https://mumo.chat/install",
  "bugs": {
    "url": "https://github.com/mumo-chat/mumo-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mumo-chat/mumo-vscode.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "mcp",
    "deliberation",
    "multi-model",
    "claude",
    "gpt",
    "gemini",
    "panel",
    "architecture",
    "design-review",
    "code-review"
  ],
  "icon": "images/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "mumo",
        "label": "mumo"
      }
    ],
    "commands": [
      {
        "command": "mumo.setApiKey",
        "title": "mumo: Set API Key"
      },
      {
        "command": "mumo.openSessions",
        "title": "mumo: Open Recent Sessions"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.101.0",
    "typescript": "^5.9.2"
  }
}
